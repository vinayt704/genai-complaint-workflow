# =============================================================
#  Copy this file to .env and fill in the values you need.
#  NEVER commit .env to Git (it is listed in .gitignore).
# =============================================================

# ---- LLM provider: openai | azure_openai | gemini | mock ----
#  mock = offline heuristic client (no API key, no cost) for testing the pipeline
LLM_PROVIDER=openai

# Model name (leave empty to use the provider default)
#   openai default: gpt-4o-mini   | gemini default: gemini-2.5-flash
#   azure_openai uses AZURE_OPENAI_DEPLOYMENT instead
MODEL_NAME=

# Temperatures. Set to "none" for models that do not accept a temperature
# parameter (e.g. some reasoning models).
EXTRACTION_TEMPERATURE=0.0
GENERATION_TEMPERATURE=0.3

# ---- OpenAI ----
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint
OPENAI_BASE_URL=

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Google Gemini (free tier available at https://aistudio.google.com) ----
GOOGLE_API_KEY=

# ---- Workflow ----
DATA_DIR=data
OUTPUT_DIR=output
LOG_DIR=logs
LOG_LEVEL=INFO
MAX_WORKERS=3                 # documents processed in parallel
LLM_MAX_RETRIES=3             # retries per LLM call (backoff)
LLM_TIMEOUT_SECONDS=60
MAX_FILE_SIZE_MB=10
MAX_DOCUMENT_CHARS=20000      # longer documents are truncated (logged as a warning)
GROUNDING_MAX_CORRECTIONS=1   # self-correction attempts when generated text is ungrounded

# ---- Branding used in customer emails ----
COMPANY_NAME=Contoso Customer Care
EMAIL_SIGNATURE=Customer Care Team, Contoso
